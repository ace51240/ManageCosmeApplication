CREATE TABLE Cosmetic (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    brand_name TEXT,
    product_name TEXT,
    category_name TEXT,
    memo TEXT,
    image_path TEXT,
    created_at INTEGER NOT NULL,
    is_favorite INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE Recipe (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    memo TEXT,
    created_at INTEGER NOT NULL
);

CREATE TABLE RecipeCosmetic (
    recipe_id INTEGER NOT NULL,
    cosmetic_id INTEGER NOT NULL,
    PRIMARY KEY (recipe_id, cosmetic_id),
    FOREIGN KEY (recipe_id) REFERENCES Recipe(id) ON DELETE CASCADE,
    FOREIGN KEY (cosmetic_id) REFERENCES Cosmetic(id) ON DELETE CASCADE
);

-- Cosmetic Queries
selectAllCosmetics:
SELECT *
FROM Cosmetic;

selectCosmeticById:
SELECT *
FROM Cosmetic
WHERE id = ?;

insertCosmetic:
INSERT INTO Cosmetic (id, brand_name, product_name, category_name, memo, image_path, created_at, is_favorite)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateCosmetic:
UPDATE Cosmetic
SET brand_name = ?, product_name = ?, category_name = ?, memo = ?, image_path = ?, is_favorite = ?
WHERE id = ?;

deleteCosmetic:
DELETE FROM Cosmetic
WHERE id = ?;

-- Recipe Queries
selectAllRecipes:
SELECT *
FROM Recipe;

selectRecipeById:
SELECT *
FROM Recipe
WHERE id = ?;

insertRecipe:
INSERT INTO Recipe (id, title, memo, created_at)
VALUES (?, ?, ?, ?);

updateRecipe:
UPDATE Recipe
SET title = ?, memo = ?
WHERE id = ?;

deleteRecipe:
DELETE FROM Recipe
WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

-- RecipeCosmetic Queries
insertRecipeCosmetic:
INSERT INTO RecipeCosmetic (recipe_id, cosmetic_id)
VALUES (?, ?);

selectCosmeticsForRecipe:
SELECT C.*
FROM Cosmetic C
JOIN RecipeCosmetic RC ON C.id = RC.cosmetic_id
WHERE RC.recipe_id = ?;

deleteRecipeCosmetics:
DELETE FROM RecipeCosmetic
WHERE recipe_id = ?;
